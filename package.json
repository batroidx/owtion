{
  "name": "owtion",
  "version": "0.1.3",
  "description": "Локальный блочный редактор заметок и баз знаний",
  "author": "Owtion",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "make": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-table-cell": "3.31.4",
    "@tiptap/extension-table-header": "3.31.4",
    "@tiptap/extension-table-row": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "better-sqlite3": "12.4.1",
    "cmdk": "1.1.1",
    "electron-store": "11.0.2",
    "fuse.js": "7.5.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.51.0",
    "nanoid": "6.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tippy.js": "6.3.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "10.4.22",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "build": {
    "appId": "com.owtion.notes",
    "productName": "Owtion",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "favicon/favicon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "favicon/favicon.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "favicon/favicon.png",
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "favicon/favicon.png",
        "to": "favicon.png"
      },
      {
        "from": "favicon/favicon.ico",
        "to": "favicon.ico"
      }
    ]
  }
}
